# TechSwap Environment Variables

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/techswap

# Authentication
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRES_IN=7d
BCRYPT_SALT=10

# Application
NODE_ENV=production
CLIENT_URL=http://localhost:5173
PORT=3000

# Optional: External AI API (optional, rule-based fallback available)
AI_API_KEY=  # Leave empty for rule-based fallback

# Payment (sandbox/test mode)
PAYMENT_API_KEY=  # Stripe test key, leave empty for demo
PAYMENT_SUCCESS_URL=http://localhost:5173/checkout/success
PAYMENT_CANCEL_URL=http://localhost:5173/checkout/cancel

# Google Maps (for nearby search deep links)
GOOGLE_MAPS_API_KEY=  # Optional, for deep links only

# Rate limiting
API_RATE_LIMIT=100  # requests per 15 minutes per IP